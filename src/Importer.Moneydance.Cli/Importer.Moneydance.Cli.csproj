<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Coffer.Importer.Moneydance</RootNamespace>
    <AssemblyName>coffer-import-moneydance</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Importer.Moneydance\Importer.Moneydance.csproj" />
  </ItemGroup>

  <!-- ImportCommand.Settings + the command classes are internal; the test
       project exercises them (arg validation, the end-to-end demo import). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Importer.Moneydance.Tests" />
  </ItemGroup>

</Project>
