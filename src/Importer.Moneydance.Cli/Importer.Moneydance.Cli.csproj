<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Coffer.Importer.Moneydance</RootNamespace>
    <AssemblyName>coffer-import-moneydance</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Importer.Moneydance\Importer.Moneydance.csproj" />
  </ItemGroup>

  <!-- The command classes are internal; the test project checks the command set
       and runs the diagnostics end to end. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Importer.Moneydance.Tests" />
  </ItemGroup>

</Project>
