<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Coffer.Importer.Moneydance</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coffer.Domain.Investment\Coffer.Domain.Investment.csproj" />
    <ProjectReference Include="..\Coffer.Domain.Reminders\Coffer.Domain.Reminders.csproj" />
  </ItemGroup>

  <!-- The CLI (coffer-import-moneydance) was this assembly before the ADR-0071
       lib/CLI split; it still consumes internal pipeline/repo/reader types. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Importer.Moneydance.Tests" />
    <InternalsVisibleTo Include="coffer-import-moneydance" />
  </ItemGroup>

</Project>
