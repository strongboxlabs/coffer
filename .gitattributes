# Default to LF line endings; let git normalize on commit on Windows hosts.
* text=auto eol=lf

# Explicit LF for text formats that pipes / containers will choke on with CRLF.
*.sh           text eol=lf
*.bash         text eol=lf
*.sql          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.cs           text eol=lf
*.ts           text eol=lf
*.tsx          text eol=lf
*.js           text eol=lf
*.jsx          text eol=lf
*.css          text eol=lf
*.html         text eol=lf
Dockerfile     text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# Windows-only scripts keep CRLF.
*.ps1          text eol=crlf
*.bat          text eol=crlf
*.cmd          text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.dump  binary
