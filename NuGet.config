<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scope this repo to nuget.org only.
       Overrides any user/machine-level feeds (e.g. private corporate feeds)
       that would otherwise be inherited. Keeps the build hermetic and
       reproducible across machines. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
