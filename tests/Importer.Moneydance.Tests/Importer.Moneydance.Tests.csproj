<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Coffer.Importer.Moneydance.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- diagnosticMessages: the per-test database fixture's end-of-run failure (a
         database left behind, a failed drop, a changed template or role) is a
         collection cleanup failure, which the console logger at minimal verbosity
         prints as its exception type alone. The fixture also writes it as a
         diagnostic message, which this setting makes the console print in full. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Pin the transitive SSH.NET to the patched version, same as Api.Tests does and
         for the same reason: Testcontainers.PostgreSql 4.13.0 (the latest) resolves
         2025.1.0, which GHSA-q939-rpr3-3284 flags high — ScpClient's recursive download
         doesn't validate remote-supplied filenames. Nothing here uses ScpClient; it
         arrives through Testcontainers' port-forwarding path. Audit warnings are errors,
         so carrying it fails the build.

         Each test project needs its own pin. A local build does not show a missing
         one: NuGet audits at RESTORE time, so a cached restore runs no fresh audit,
         while CI restores clean and fails. If you touch either pin, verify with a
         forced restore rather than an incremental build.
         Remove both once Testcontainers' own floor moves past it. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- The same System.Security.Cryptography.Xml pin as Api.Tests, for the same
         reason: it arrives through the Api project's OpenIddict closure (referenced
         below for the migration runner), and this plain test SDK project audits the
         transitive. Its Pkcs dependency moves with it. Remove with Api.Tests' pin. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Every database test's constructor takes an ITestOutputHelper (DatabaseTest). -->
    <Using Include="Xunit.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The boundary magnitudes are ONE source of truth, and the two test assemblies
      are independent, so the file is linked rather than copied. Duplicating the
      edge values is how they drift: a case added for the API suites would silently
      not apply here, and the importer is precisely where a money figure ENTERS the
      system. Boundary.cs depends only on xunit, so it links cleanly.
    -->
    <Compile Include="..\Api.Tests\Integration\Infra\Boundary.cs"
             Link="Infra\Boundary.cs" />
    <!-- The stored-equals-computed check both fixtures end with, linked for the same
         reason: two copies of the check could disagree on what counts as drift. -->
    <Compile Include="..\Api.Tests\Integration\Infra\StoredNotesDatabaseCheck.cs"
             Link="Infra\StoredNotesDatabaseCheck.cs" />
    <!--
      The per-test database machinery (clone from the template, end-of-test session
      checks, background drop, leftover report) is the API test project's, linked for
      the same reason: two copies of an isolation guarantee drift, and the copy that
      drifted is the one nobody is looking at. It depends only on Npgsql and xunit.
    -->
    <Compile Include="..\Api.Tests\Integration\Infra\TestDatabaseCluster.cs"
             Link="Infra\TestDatabaseCluster.cs" />
    <!-- Migration 264's register display before and after, read the same way by the
         API's upgrade tests and the importer's vintage tests. -->
    <Compile Include="..\Api.Tests\Integration\Infra\RegisterDisplay.cs"
             Link="Infra\RegisterDisplay.cs" />
    <!-- The memo and tag placement invariants, held over the importer's fixtures here
         and over the whole Demo, its examples included, by the API's tests: one copy. -->
    <Compile Include="..\Api.Tests\Integration\Infra\MemoPlacementInvariants.cs"
             Link="Infra\MemoPlacementInvariants.cs" />
    <!-- The skip for a test that reads the maintainer tree, which the public snapshot does
         not carry: one rule for both assemblies. -->
    <Compile Include="..\Api.Tests\Integration\Infra\MaintainerTree.cs"
             Link="Infra\MaintainerTree.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Importer.Moneydance\Importer.Moneydance.csproj" />
    <ProjectReference Include="..\..\src\Importer.Moneydance.Cli\Importer.Moneydance.Cli.csproj" />
    <!-- For the production MigrationRunner (and DbSessionTimeZone): the template is
         migrated the way an install is, as coffer_service, not by a copy of the runner,
         and an install runs the API's C# migration steps between the SQL files
         (MigrationRunner.CSharpSteps). -->
    <ProjectReference Include="..\..\src\Api\Api.csproj" />
  </ItemGroup>

</Project>