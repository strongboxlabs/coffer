POSTGRES_USER=coffer
POSTGRES_DB=coffer
# Host port for Postgres. docker-compose binds it to 127.0.0.1 only — the app
# never uses it (the API reaches Postgres over the compose network), so it exists
# purely for attaching psql or a GUI client from the host. Drop the ports stanza
# in docker-compose.yml if nothing on the host needs to connect.
POSTGRES_PORT=5432
# initdb flags, applied ONCE when the data directory is first created. The default
# below is what makes every auth path require a password (initdb otherwise leaves
# `trust` on the unix socket, 127.0.0.1 and ::1). Only override if you know why.
# Existing installs pre-date this: see scripts/harden-pg-hba.sh.
#POSTGRES_INITDB_ARGS=--auth-local=scram-sha-256 --auth-host=scram-sha-256

# ---------------------------------------------------------------------------
# The three database passwords are NOT set here. They live in files under
# ./secrets/ and reach the containers as docker-compose secrets:
#
#   secrets/postgres_password          — the superuser
#   secrets/coffer_service_password    — coffer_service (BYPASSRLS)
#   secrets/coffer_app_password        — coffer_app (NOBYPASSRLS)
#
# Why not here: an environment variable is readable via `docker inspect`,
# /proc/<pid>/environ, any child process's environment and crash dumps, and
# these are the credentials every query authenticates with. Same reasoning
# ADR-0092 D1 used to move the master KEK out of this file.
#
# To create them:
#   scripts/install.sh            generates them on a fresh install
#   scripts/migrate-db-secrets.sh moves them out of an existing .env
#   or by hand:
#     mkdir -p secrets && chmod 700 secrets
#     for s in postgres_password coffer_service_password coffer_app_password; do
#       printf '%s' "$(openssl rand -hex 24)" > "secrets/$s"; chmod 644 "secrets/$s"
#     done
#
# The files are 0644 inside a 0700 directory on purpose: outside swarm, compose
# keeps the host file's ownership, and the Postgres entrypoint re-execs as
# uid 999 before reading POSTGRES_PASSWORD_FILE — so a 0600 file owned by you is
# unreadable in-container. The directory is what keeps other local users out.
#
# The roles themselves (ADR-0020 Phase D), for reference:
#
#   * coffer_service: BYPASSRLS, used by the API's migration runner,
#     importer, sync worker, and the WebAuthn pre-auth lookups. The
#     COFFER_DB_CONNECTION env var (consumed by the importer) and
#     Api:ServiceConnectionString config (consumed by the API) point
#     at this role.
#
#   * coffer_app: NOBYPASSRLS, used by the API at request-handling
#     time. The Api:ConnectionString config points at this role; the
#     API sets app.user_id per request so RLS policies filter rows
#     to the authenticated user's grants.
#
# Constraint: passwords must NOT contain the literal substrings $svc$
# or $app$ (used as dollar-quote tags by db/init/00-init-roles.sh).
# Alphanumeric + common punctuation is safe.
# ---------------------------------------------------------------------------

# Master KEK (ADR-0014 §Layer 4 + ADR-0026). 32 bytes, base64-encoded;
# wraps every ledger's LEK, which in turn seals high-value secrets
# (SimpleFIN access URL etc.).
#
# DEPRECATED as a channel by ADR-0092 D1 — the key now lives in a FILE at
# Api:MasterKey:Path (default data/master.key on the coffer_data volume). An env
# var is visible in `docker inspect`, /proc/<pid>/environ, child environments and
# crash dumps; a file is not, and it is also the shape Docker secrets, Kubernetes
# Secrets and Key Vault CSI mounts already speak — point COFFER_MASTER_KEY_PATH
# at one of those to keep the key off the app's own volume.
#
# Still honoured for one release: if set, it wins and is copied to the key file on
# first boot, with a deprecation warning in the log. Then remove it from this
# file. The dev sample below is intentionally well-known so a fresh checkout boots
# without operator action — it has zero value as a secret outside dev.
COFFER_MASTER_KEK_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Where the key file lives inside the container. Leave unset for the default
# (data/master.key on coffer_data). Set to e.g. /run/secrets/coffer_kek to read an
# injected secret instead.
#COFFER_MASTER_KEY_PATH=/run/secrets/coffer_kek
# KEK id label stamped on new wraps (ledgers.lek_kek_id). Default v1; a rotation
# (System → Encryption → Rotate) bumps it and writes the new id INTO the key file,
# which is then the source of truth — so after your first rotation this variable is
# no longer what decides the id. It only seeds a brand-new install. Leave at v1.
# (The `rotate-kek` CLI subcommand that used to bump it was removed by ADR-0092.)
COFFER_MASTER_KEK_ID=v1

# --- API container (ADR-0059, single-container API+SPA) --------------------
# Consumed by the `api` service in docker-compose — the dev path
# (scripts/dev-up-docker.sh) and production both run the API this way.
ASPNETCORE_ENVIRONMENT=Production
# Host port mapped to the container's :8080.
API_PORT=8080
# MCP read-only report server (ADR-0063), off by default. Set to true to
# expose /mcp + the Connected-apps token UI for AI clients (Claude, etc.).
COFFER_MCP_ENABLED=false
# The container image, REQUIRED — docker-compose.yml has no default for it.
#
# There isn't a default that's right for anyone but one owner:
# .github/workflows/release.yml publishes to
# ghcr.io/<the building repo's owner>/coffer, so whoever builds the image owns the
# package. A hardcoded fallback meant an install could quietly pull from a
# registry that wasn't its own, which is why it's now explicit.
#
# scripts/install.sh derives this from the repo it fetched your config from and
# writes it here, so you normally don't set it by hand — the install one-liner in
# the README is the path that needs no thought.
#
# Setting it by hand (a manual `docker compose up`, a mirror, a private registry):
# use the owner of the repository you got this code from, i.e. for
# github.com/<owner>/coffer the image is ghcr.io/<owner>/coffer. Building locally
# (`docker compose build`) tags the image with this name too, so any value works
# for a build-from-source install.
COFFER_IMAGE=ghcr.io/<owner>/coffer
# Tag to pull (ADR-0060 DR). 'latest', or on a recovery host pin the version you
# backed up from (e.g. COFFER_IMAGE_TAG=0.44.1). Only used when pulling rather
# than building locally.
COFFER_IMAGE_TAG=latest
# Hard memory cap for the API container (docker-compose mem_limit). The .NET GC
# is cgroup-aware and caps its managed heap at ~75% of this, so the process
# can't creep to multiple GB. Paired with Workstation GC (DOTNET_gcServer=0 in
# docker-compose). Default 1g suits a small self-hosted install; lower to e.g.
# 512m once you've confirmed a small working set, or raise for heavier use.
# Accepts docker size units (512m, 1g, 2g, …).
COFFER_API_MEM_LIMIT=1g
# Hard memory cap for the Postgres container. Read this before lowering it: it is
# NOT the same kind of knob as the one above. .NET reads its cgroup limit and
# collects harder as it approaches; Postgres does not adapt at all. Hitting this
# limit means the kernel OOM-kills a backend, and the postmaster treats that as a
# crash — it restarts the whole cluster and runs crash recovery. So treat it as a
# runaway backstop, not a tuning dial. 1g is comfortable for the default
# shared_buffers (128MB), maintenance_work_mem during a restore, and this
# install's handful of connections. If you lower it, lower shared_buffers and
# work_mem to match.
POSTGRES_MEM_LIMIT=1g
# WebAuthn relying party. RpId is the bare host — no scheme, no port. It is not
# derived from the URLs below: for a subdomain split it must be the parent domain
# (coffer.example.com covers mcp.coffer.example.com), and working that out from a
# URL needs a public-suffix list. Changing it invalidates every enrolled passkey.
COFFER_RP_ID=localhost

# Where Coffer is reached. Both are allowed passkey origins (Fido2 Origins__0 and
# __1); COFFER_MCP_URL additionally tells the admin UI which address to hand an
# MCP client, so it is right for a split-host install rather than guessing from
# whichever host the admin happens to be browsing.
#
# Same value when MCP shares the main host — they dedupe at runtime. For a real
# install: COFFER_WEB_URL=https://coffer.example.com and
# COFFER_MCP_URL=https://mcp.coffer.example.com.
#
# Replaces COFFER_WEB_ORIGIN_0 / _1, which still work (compose falls back to
# them, so an existing .env needs no edit). The old names described a position in
# an allowed-origins array whose second slot meant "the MCP host" only by
# convention — fine while nothing read it, wrong once something did. For a THIRD
# allowed origin, add COFFER_WEB_ORIGIN_2 plus a matching Origins__2 in compose.
COFFER_WEB_URL=http://localhost:8080
COFFER_MCP_URL=http://localhost:8080
